{
  "name": "paper-xray",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @paper-xray/web dev",
    "db:externalize": "pnpm --filter @paper-xray/server db:externalize",
    "db:providers": "pnpm --filter @paper-xray/server db:providers",
    "db:comments": "pnpm --filter @paper-xray/server db:comments",
    "db:install": "pnpm --filter @paper-xray/server db:install",
    "dev:server": "pnpm --filter @paper-xray/server dev",
    "build": "pnpm -r build",
    "pretest": "pnpm --filter @paper-xray/contracts build",
    "test": "pnpm -r test",
    "pretypecheck": "pnpm --filter @paper-xray/contracts build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "eval": "pnpm --filter @paper-xray/contracts build && pnpm --filter @paper-xray/server eval",
    "db:lens-colors": "pnpm --filter @paper-xray/server db:lens-colors",
    "db:notifications": "pnpm --filter @paper-xray/server db:notifications",
    "db:votes": "pnpm --filter @paper-xray/server db:votes"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
