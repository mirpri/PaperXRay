PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=paperxray
DB_PASSWORD=paperxray
DB_NAME=paperxray
WEB_ORIGIN=http://localhost:5173

# PDF, normalized text and CharMap directory; back up/share this entire directory.
# Defaults to apps/server/uploads.
# UPLOADS_DIR=

# Session cookie signing secret — set a real random value outside local dev.
SESSION_SECRET=change-me

# mirpass OAuth2 app registration (docs/02-decisions.md #11). Bootstrap
# defaults only — the admin panel can override the whole sso_config row
# (including switching to a different OAuth2 IdP) without redeploying.
MIRPASS_CLIENT_ID=
MIRPASS_CLIENT_SECRET=
MIRPASS_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Comma-separated emails bootstrapped as admin the first time they log in via SSO.
ADMIN_EMAILS=


# URL import host allowlist (docs/02-decisions.md #7), comma-separated; each
# entry also matches its subdomains. Private/loopback/link-local addresses
# are always refused regardless of this list.
# IMPORT_ALLOWED_HOSTS=arxiv.org,openreview.net,aclanthology.org
